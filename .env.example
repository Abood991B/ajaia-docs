# Local development uses a libSQL file and needs no configuration at all.
# Copy this file to .env.local only when you want to point at a remote database.

# Required in production. Signs the session cookie.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional. When set, the app talks to Turso instead of ./local.db.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
